[Unit]
Description=qtile session
# Pulls in graphical-session.target (which refuses manual start) so that
# xdg-desktop-portal.service can satisfy its "Requisite=graphical-session.target"
# and start. Without this, flatpaks (e.g. Slack) can't open links via the portal.
BindsTo=graphical-session.target
Before=graphical-session.target
# Nothing else pulls in graphical-session-pre.target under qtile (it refuses
# manual start, so it has to arrive as a dependency). Units that hook there,
# such as xdg-user-dirs.service, never run otherwise.
Wants=graphical-session-pre.target
After=graphical-session-pre.target
# Same story for the XDG autostart entries: xdg-desktop-autostart.target also
# refuses manual start, so "systemctl start" on it is rejected and nothing
# autostarts. It has to be pulled in from here, the way a desktop environment's
# own session target does it. No ordering needed, every generated
# app-*@autostart.service already carries After=graphical-session.target.
Wants=xdg-desktop-autostart.target
